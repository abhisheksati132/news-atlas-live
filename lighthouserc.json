{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": ["http://localhost/", "http://localhost/country/india/"],
      "numberOfRuns": 1,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "skipAudits": ["screenshot-thumbnails", "final-screenshot"]
      }
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.5 }],
        "categories:accessibility": ["error", { "minScore": 0.85 }],
        "categories:best-practices": ["error", { "minScore": 0.85 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 1400000 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 200000 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 3500000 }],
        "color-contrast": "error",
        "image-size-responsive": "error",
        "unsized-images": "error",
        "unused-javascript": "warn",
        "uses-optimized-images": "warn",
        "unused-css-rules": "warn",
        "uses-long-cache-ttl": "off",
        "font-display-insight": "off",
        "forced-reflow-insight": "off",
        "network-dependency-tree-insight": "off",
        "render-blocking-insight": "off",
        "render-blocking-resources": "warn",
        "dom-size-insight": "off",
        "errors-in-console": "off",
        "valid-source-maps": "off"
      }
    }
  }
}
