# ============================================================
# NewsAtlas — .gitignore
# ============================================================

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Node dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build_out.txt
*.log
build/
.vite/
.vite_cache/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed

# Coverage
coverage/
.nyc_output/

# Temp files
tmp/
temp/

.vercel
.env*
