# ============================================================
# NewsAtlas — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git — it is in .gitignore.
# ============================================================

# Groq API key for AI briefings (https://console.groq.com)
GROQ_API_KEY=

# NewsAPI.org key for news feeds (https://newsapi.org)
NEWS_API_KEY=


# Mapbox public token (https://account.mapbox.com)
MAPBOX_TOKEN=

# Firebase config as a JSON string (optional — for auth features)
# Example: {"apiKey":"...","authDomain":"...","projectId":"..."}
NEXT_PUBLIC_FIREBASE_CONFIG=
