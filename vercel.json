{
    "version": 2,
    "cleanUrls": true,
    "trailingSlash": false,
    "builds": [
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": { "distDir": "dist" }
        },
        {
            "src": "api/*.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        { "src": "/api/([^.]+)", "dest": "/api/$1.js" },
        { "src": "/api/(.*)", "dest": "/api/$1" },
        { "src": "/app/(.*)", "dest": "/app.html" },
        { "src": "/app", "dest": "/app.html" },
        { "src": "/(.*)", "dest": "/$1" }
    ]
}