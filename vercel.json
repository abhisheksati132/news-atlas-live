{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/api/gdelt-geo", "destination": "/api/gdelt?mode=geo" },
    { "source": "/api/news-alerts", "destination": "/api/news?type=alerts" }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "public/data/**"
    }
  }
}