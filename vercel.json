{
    "version": 2,
    "cleanUrls": true,
    "trailingSlash": false,
    "routes": [
        { "src": "/api/([^.]+)", "dest": "/api/$1.js" },
        { "src": "/api/(.*)", "dest": "/api/$1" },
        { "src": "/app/(.*)", "dest": "/app.html" },
        { "src": "/app", "dest": "/app.html" },
        { "src": "/(.*)", "dest": "/$1" }
    ]
}